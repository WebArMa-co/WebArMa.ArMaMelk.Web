@page "/profile"
@inject NavigationManager Navigation

<div class="w-full max-w-3xl mx-auto p-4 md:p-6 pb-36 space-y-6 animate-fade-in">

    <!-- هدر صفحه -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black text-lajevard dark:text-white">حساب کاربری</h1>
            <p class="text-xs md:text-sm text-lajevard/60 dark:text-white/60 mt-0.5">مدیریت اطلاعات شخصی و تنظیمات پنل</p>
        </div>
        <button type="button" @onclick="GoBack" class="p-2.5 rounded-2xl bg-white dark:bg-sormee-light border border-gray-200 dark:border-white/10 text-gray-500 hover:text-blue-600 transition-colors">
            <svg class="w-5 h-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>
    </div>

    <!-- بخش آپلود تصویر پروفایل -->
    <div class="bg-white dark:bg-sormee-light p-6 md:p-8 rounded-[2rem] border border-blue-600/10 dark:border-white/5 shadow-sm flex flex-col sm:flex-row items-center gap-6">

        <div class="relative group cursor-pointer">
            <!-- آواتار فعلی -->
            <div class="w-24 h-24 rounded-3xl bg-blue-50 dark:bg-white/5 border-2 border-blue-100 dark:border-white/10 flex items-center justify-center text-blue-600 dark:text-blue-400 font-black text-3xl shadow-inner overflow-hidden">
                @if (string.IsNullOrEmpty(userProfile.AvatarUrl))
                {
                    <span>@userProfile.FullName.Substring(0, 1)</span>
                }
                else
                {
                    <img src="@userProfile.AvatarUrl" class="w-full h-full object-cover" alt="Profile" />
                }
            </div>

            <!-- دکمه شناور تغییر عکس -->
            <button class="absolute -bottom-2 -right-2 w-9 h-9 bg-blue-600 text-white rounded-xl shadow-lg border-2 border-white dark:border-sormee-light flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </button>
        </div>

        <div class="text-center sm:text-right space-y-1">
            <h3 class="font-bold text-lg text-lajevard dark:text-white">تصویر پروفایل</h3>
            <p class="text-xs text-lajevard/60 dark:text-white/60">فرمت‌های مجاز: JPG و PNG. حداکثر حجم ۲ مگابایت.</p>
        </div>
    </div>

    <!-- فرم اطلاعات شخصی -->
    <div class="bg-white dark:bg-sormee-light p-6 md:p-8 rounded-[2rem] border border-blue-600/10 dark:border-white/5 shadow-sm space-y-6">
        <h3 class="font-bold text-base text-lajevard dark:text-white flex items-center gap-2 border-b border-gray-100 dark:border-white/5 pb-3">
            <span>👤</span> مشخصات فردی و شغلی
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
            <!-- شماره موبایل (غیرقابل تغییر) -->
            <div class="space-y-1.5 md:col-span-2">
                <div class="flex items-center justify-between pr-1">
                    <label class="text-xs font-bold text-lajevard/70 dark:text-white/70">شماره موبایل (شناسه ورود)</label>
                    <span class="text-[10px] font-bold text-amber-500 bg-amber-50 dark:bg-amber-500/10 px-2 py-0.5 rounded-lg flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        غیرقابل تغییر
                    </span>
                </div>
                <input type="tel"
                       value="@userProfile.PhoneNumber"
                       class="w-full bg-gray-100 dark:bg-black/20 border border-transparent rounded-2xl py-3.5 px-4 text-sm text-lajevard/50 dark:text-white/40 font-bold tracking-widest cursor-not-allowed"
                       dir="ltr"
                       readonly disabled />
            </div>

            <!-- نام و نام خانوادگی -->
            <div class="space-y-1.5">
                <label class="text-xs font-bold text-lajevard/70 dark:text-white/70 block pr-1">نام و نام خانوادگی</label>
                <input type="text"
                       @bind="userProfile.FullName"
                       placeholder="نام خود را وارد کنید"
                       class="w-full bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-2xl py-3.5 px-4 text-sm text-lajevard dark:text-white focus:outline-none focus:border-blue-500 transition-all font-bold" />
            </div>

            <!-- نام آژانس -->
            <div class="space-y-1.5">
                <label class="text-xs font-bold text-lajevard/70 dark:text-white/70 block pr-1">نام آژانس املاک</label>
                <input type="text"
                       @bind="userProfile.AgencyName"
                       placeholder="مثلاً: املاک پایتخت"
                       class="w-full bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-2xl py-3.5 px-4 text-sm text-lajevard dark:text-white focus:outline-none focus:border-blue-500 transition-all font-bold" />
            </div>

            <!-- ایمیل (اختیاری) -->
            <div class="space-y-1.5 md:col-span-2">
                <label class="text-xs font-bold text-lajevard/70 dark:text-white/70 block pr-1">ایمیل (اختیاری)</label>
                <input type="email"
                       @bind="userProfile.Email"
                       placeholder="example@mail.com"
                       class="w-full bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-2xl py-3.5 px-4 text-sm text-lajevard dark:text-white focus:outline-none focus:border-blue-500 transition-all font-bold"
                       dir="ltr" />
            </div>
        </div>
    </div>

    <!-- تنظیمات پنل (استفاده از کامپوننت ToggleSwitch) -->
    <div class="bg-white dark:bg-sormee-light p-6 md:p-8 rounded-[2rem] border border-blue-600/10 dark:border-white/5 shadow-sm space-y-6">
        <h3 class="font-bold text-base text-lajevard dark:text-white flex items-center gap-2 border-b border-gray-100 dark:border-white/5 pb-3">
            <span>⚙️</span> تنظیمات و اعلانات
        </h3>

        <div class="divide-y divide-gray-100 dark:divide-white/5">
            <div class="py-2">
                <ToggleSwitch @bind-Value="userProfile.ReceiveSmsAlerts"
                              Label="دریافت پیامک یادآوری"
                              Description="یادآوری جلسات و بازدیدها به صورت پیامک ارسال شود." />
            </div>
            <div class="py-2">
                <ToggleSwitch @bind-Value="userProfile.ReceiveNewFileAlerts"
                              Label="اعلان فایل‌های جدید"
                              Description="وقتی همکاران فایل جدیدی در سیستم ثبت کردند مطلع شوم." />
            </div>
        </div>
    </div>

    <!-- دکمه ذخیره تغییرات -->
    <div class="pt-2">
        <button type="button" @onclick="SaveChanges" disabled="@isSaving" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl text-sm font-black shadow-lg shadow-blue-600/30 transition-all active:scale-95 disabled:opacity-70 disabled:active:scale-100 flex items-center justify-center gap-2">
            @if (isSaving)
            {
                <svg class="animate-spin w-5 h-5 text-white" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span>در حال ذخیره‌سازی...</span>
            }
            else
            {
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                <span>ذخیره تغییرات پروفایل</span>
            }
        </button>
    </div>

</div>

@code {
    public class UserProfileModel
    {
        public string FullName { get; set; } = "آرش محمودی";
        public string PhoneNumber { get; set; } = "09123456789";
        public string AgencyName { get; set; } = "املاک پایتخت";
        public string Email { get; set; } = "";
        public string AvatarUrl { get; set; } = ""; // اگر خالی باشد نام اختصاری نشان داده می‌شود
        public bool ReceiveSmsAlerts { get; set; } = true;
        public bool ReceiveNewFileAlerts { get; set; } = false;
    }

    private UserProfileModel userProfile = new();
    private bool isSaving = false;

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private async Task SaveChanges()
    {
        isSaving = true;

        // شبیه‌سازی درخواست ذخیره‌سازی در دیتابیس
        await Task.Delay(1500);

        isSaving = false;

        // در صورت نیاز نمایش یک Toast موفقیت‌آمیز در اینجا قرار می‌گیرد
    }
}
