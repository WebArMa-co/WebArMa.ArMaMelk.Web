@inject IJSRuntime JSRuntime

<div class="w-full text-lajevard dark:text-white relative">

    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium mb-2 ml-1 text-lajevard/80 dark:text-white/80">@Label</label>
    }

    <!-- نمای کوچک نقشه واقعی در فرم -->
    <div @onclick="OpenMap" class="relative w-full h-36 rounded-[1.5rem] overflow-hidden cursor-pointer group border border-blue-600/10 dark:border-white/5 shadow-sm hover:shadow-md transition-all">

        <!-- این div نقشه کوچک را در خود جای می‌دهد -->
        <div id="@SmallMapId" class="absolute inset-0 z-0 bg-blue-50 dark:bg-sormee-light"></div>

        <!-- لایه شیشه‌ای روی نقشه برای دریافت کلیک و جلوگیری از اسکرول تصادفی -->
        <div class="absolute inset-0 z-10 bg-black/5 hover:bg-black/0 transition-colors"></div>

        <!-- پین وسط نقشه کوچک -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-blue-600 group-hover:scale-110 group-hover:-translate-y-3 transition-transform duration-300 z-20">
            <svg class="w-10 h-10 drop-shadow-md" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
            </svg>
        </div>

        <!-- اطلاعات مختصات پایین نقشه -->
        <div class="absolute bottom-2 inset-x-2 bg-white/90 dark:bg-sormee/90 backdrop-blur-sm rounded-xl py-2 px-3 flex items-center justify-between pointer-events-none border border-blue-600/10 dark:border-white/5 z-20">
            <span class="text-xs font-bold text-lajevard dark:text-white">
                @(HasLocation ? "موقعیت ملک" : "انتخاب روی نقشه")
            </span>
            @if (HasLocation)
            {
                <span class="text-[10px] text-blue-600 font-bold tracking-wider" dir="ltr">
                    @Math.Round(Latitude.Value, 4), @Math.Round(Longitude.Value, 4)
                </span>
            }
            else
            {
                <span class="text-[10px] bg-blue-600 text-white px-2 py-1 rounded-lg">لمس کنید</span>
            }
        </div>
    </div>
</div>

<!-- مودال تمام‌صفحه نقشه -->
@if (isMapOpen)
{
    <div class="fixed inset-0 z-[9999] bg-kahgel dark:bg-sormee flex flex-col animate-slide-up">

        <div class="h-16 bg-white dark:bg-sormee-light flex items-center justify-between px-4 shadow-sm relative z-50">
            <h3 class="font-bold text-lg text-lajevard dark:text-white">تعیین موقعیت ملک</h3>
            <button @onclick="CloseMap" class="p-2 text-lajevard/60 dark:text-white/60 hover:text-red-500 transition-colors rounded-xl bg-gray-100 dark:bg-white/10">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <div class="flex-1 relative overflow-hidden bg-gray-100">
            <!-- کانتینر نقشه مودال -->
            <div id="@LargeMapId" class="absolute inset-0 z-0"></div>

            <!-- پین وسط صفحه -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-[500] pointer-events-none flex flex-col items-center">
                <div class="bg-lajevard text-white text-[10px] font-bold px-3 py-1.5 rounded-lg mb-1 shadow-lg animate-bounce">
                    ملک اینجاست
                </div>
                <svg class="w-12 h-12 text-blue-600 drop-shadow-xl" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
                </svg>
                <div class="w-4 h-1 bg-black/20 rounded-full mt-1 blur-[1px]"></div>
            </div>

            <!-- دکمه مکان‌یابی من (GPS) -->
            <button type="button" @onclick="GoToMyLocation" class="absolute bottom-6 right-4 p-3 bg-white dark:bg-sormee-light text-blue-600 rounded-full shadow-[0_8px_20px_rgba(0,0,0,0.15)] hover:scale-110 active:scale-95 transition-all z-[500] border border-blue-600/10">
                <!-- آیکون استاندارد Target / GPS -->
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3c-.46-4.17-3.77-7.48-7.94-7.94V1h-2v2.06C6.83 3.52 3.52 6.83 3.06 11H1v2h2.06c.46 4.17 3.77 7.48 7.94 7.94V23h2v-2.06c4.17-.46 7.48-3.77 7.94-7.94H23v-2h-2.06zM12 19c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z" />
                </svg>
            </button>
        </div>

        <div class="bg-white dark:bg-sormee-light p-4 shadow-[0_-10px_30px_rgba(0,0,0,0.05)] relative z-50 pb-safe">
            <button @onclick="ConfirmLocation" class="w-full py-3.5 bg-blue-600 text-white rounded-[1.25rem] text-sm font-bold shadow-lg shadow-blue-600/30 hover:bg-blue-700 active:scale-95 transition-all">
                تایید موقعیت ملک
            </button>
        </div>

    </div>
}

@code {
    [Parameter] public double? Latitude { get; set; }
    [Parameter] public double? Longitude { get; set; }
    [Parameter] public EventCallback<(double Lat, double Lng)> OnLocationSelected { get; set; }
    [Parameter] public string Label { get; set; } = "موقعیت روی نقشه";

    private bool isMapOpen = false;
    private bool HasLocation => Latitude.HasValue && Longitude.HasValue;

    // ایجاد آیدی یکتا برای نقشه‌ها تا تداخلی پیش نیاید
    private readonly string SmallMapId = "map-small-" + Guid.NewGuid().ToString("N");
    private readonly string LargeMapId = "map-large-" + Guid.NewGuid().ToString("N");

    // رندر نقشه کوچک بلافاصله پس از لود شدن صفحه فرم
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            double startLat = Latitude ?? 35.6997; // میدان آزادی تهران
            double startLng = Longitude ?? 51.3380;

            await JSRuntime.InvokeVoidAsync("leafletInterop.initStaticMap", SmallMapId, startLat, startLng);
        }
    }

    private async Task OpenMap()
    {
        isMapOpen = true;
        StateHasChanged();
        await Task.Delay(50);

        double startLat = Latitude ?? 35.6997;
        double startLng = Longitude ?? 51.3380;

        await JSRuntime.InvokeVoidAsync("leafletInterop.initInteractiveMap", LargeMapId, startLat, startLng);
    }

    private void CloseMap()
    {
        isMapOpen = false;
    }

    private async Task ConfirmLocation()
    {
        try
        {
            var center = await JSRuntime.InvokeAsync<LocationCoords>("leafletInterop.getCenter", LargeMapId);
            if (center != null)
            {
                Latitude = center.Lat;
                Longitude = center.Lng;
                await OnLocationSelected.InvokeAsync((center.Lat, center.Lng));

                // جابه‌جا کردن نقشه کوچک به مختصات جدید
                await JSRuntime.InvokeVoidAsync("leafletInterop.updateMapCenter", SmallMapId, center.Lat, center.Lng);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطا در دریافت مختصات: {ex.Message}");
        }

        isMapOpen = false;
    }

    public class LocationCoords
    {
        public double Lat { get; set; }
        public double Lng { get; set; }
    }

    private async Task GoToMyLocation()
    {
        // فراخوانی متد جاوااسکریپت برای پیدا کردن کاربر روی نقشه بزرگ
        await JSRuntime.InvokeVoidAsync("leafletInterop.goToUserLocation", LargeMapId);
    }
}
