@page "/Properties/{Id}"
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<!-- اضافه کردن فاصله پایینی کافی (pb-32) جهت عدم تداخل با BottomNav -->
<div class="w-full max-w-5xl mx-auto p-4 md:p-6 pb-36 space-y-6">

    <!-- هدر بالای صفحه و بج وضعیت محرمانگی -->
    <div class="flex items-center justify-between">
        <button type="button" @onclick="GoBack" class="p-2.5 rounded-2xl bg-white dark:bg-sormee-light border border-gray-200 dark:border-white/10 text-lajevard dark:text-white hover:bg-gray-50 dark:hover:bg-white/5 transition-colors flex items-center gap-1.5 text-xs font-bold">
            <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            بازگشت به پوشه
        </button>

        <div class="flex items-center gap-2">
            <!-- بج فایل محرمانه -->
            <span class="px-3 py-1.5 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-black flex items-center gap-1.5 border border-amber-500/20">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                فایلینگ اختصاصی
            </span>

            <!-- دکمه ویرایش فایل -->
            <button type="button" @onclick="EditProperty" class="p-2.5 rounded-2xl bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-600/20 hover:bg-blue-100 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            </button>
        </div>
    </div>

    <!-- گالری تصاویر اسلایدری -->
    <div class="relative w-full h-64 sm:h-80 md:h-96 rounded-[2rem] overflow-hidden bg-gray-100 dark:bg-white/5 border border-blue-600/10 dark:border-white/5 shadow-sm group">
        <img src="@propertyData.Images[activeImageIndex]" class="w-full h-full object-cover transition-all duration-300" alt="@propertyData.Title" />

        <div class="absolute top-4 right-4 flex items-center gap-2 z-10">
            <span class="bg-black/60 backdrop-blur-md text-white text-xs font-bold px-3 py-1 rounded-xl">
                کد: @propertyData.Code
            </span>
            <span class="text-xs font-bold px-3 py-1 rounded-xl @(propertyData.DealType == "فروش" ? "bg-emerald-500 text-white" : "bg-blue-600 text-white") shadow-md">
                @propertyData.DealType
            </span>
        </div>

        <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-md text-white text-xs font-bold px-3 py-1 rounded-xl z-10">
            @(activeImageIndex + 1) / @propertyData.Images.Count
        </div>

        @if (propertyData.Images.Count > 1)
        {
            <button type="button" @onclick="PrevImage" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/80 dark:bg-sormee/80 backdrop-blur-sm text-lajevard dark:text-white flex items-center justify-center shadow hover:scale-105 active:scale-95 transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </button>
            <button type="button" @onclick="NextImage" class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/80 dark:bg-sormee/80 backdrop-blur-sm text-lajevard dark:text-white flex items-center justify-center shadow hover:scale-105 active:scale-95 transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </button>
        }
    </div>

    <!-- ========================================== -->
    <!-- کارت قرمز/ویژه: اطلاعات محرمانه مالک (Private CRM Data) -->
    <!-- ========================================== -->
    <div class="bg-amber-500/5 dark:bg-amber-500/10 border-2 border-amber-500/30 rounded-[2rem] p-5 space-y-4">
        <div class="flex items-center justify-between border-b border-amber-500/20 pb-3">
            <h3 class="font-black text-sm text-amber-700 dark:text-amber-400 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                اطلاعات محرمانه مالک و دسترسی
            </h3>
            <span class="text-[10px] bg-amber-500 text-white font-bold px-2 py-0.5 rounded-md">فقط مشاور</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 text-xs">
            <div class="space-y-1">
                <span class="text-lajevard/50 dark:text-white/50 block text-[11px]">نام و نام خانوادگی مالک:</span>
                <span class="font-bold text-lajevard dark:text-white text-sm">@propertyData.OwnerName</span>
            </div>

            <div class="space-y-1">
                <span class="text-lajevard/50 dark:text-white/50 block text-[11px]">تماس مستقیم با مالک:</span>
                <a href="tel:@propertyData.OwnerPhone" class="font-bold text-blue-600 dark:text-blue-400 flex items-center gap-1 underline" dir="ltr">
                    @propertyData.OwnerPhone
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                </a>
            </div>

            <div class="space-y-1">
                <span class="text-lajevard/50 dark:text-white/50 block text-[11px]">پلاک، زنگ و طبقه:</span>
                <span class="font-bold text-lajevard dark:text-white">پلاک @propertyData.BuildingPlate • طبقه @propertyData.Floor • واحد @propertyData.UnitNumber</span>
            </div>

            <div class="space-y-1">
                <span class="text-lajevard/50 dark:text-white/50 block text-[11px]">پورسانت / کمیسیون توافقی:</span>
                <span class="font-bold text-emerald-600 dark:text-emerald-400">@propertyData.Commission</span>
            </div>

            <div class="space-y-1 sm:col-span-2">
                <span class="text-lajevard/50 dark:text-white/50 block text-[11px]">یادداشت اختصاصی مشاور (کف قیمت / شرایط بازدید):</span>
                <p class="font-medium text-lajevard/80 dark:text-white/80 bg-white/60 dark:bg-white/5 p-2 rounded-xl text-xs">
                    @propertyData.PrivateNotes
                </p>
            </div>
        </div>
    </div>

    <!-- مشخصات و قیمت -->
    <div class="bg-white dark:bg-sormee-light p-5 md:p-6 rounded-[2rem] border border-blue-600/10 dark:border-white/5 space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div>
                <h1 class="text-xl md:text-2xl font-black text-lajevard dark:text-white">@propertyData.Title</h1>
                <p class="text-xs md:text-sm text-lajevard/60 dark:text-white/60 mt-1">@propertyData.Location</p>
            </div>

            <div class="text-left bg-blue-50/60 dark:bg-white/5 p-3.5 rounded-2xl border border-blue-600/10 dark:border-white/5 shrink-0">
                <span class="text-[10px] text-lajevard/50 dark:text-white/50 block">قیمت کارشناسی / اعلامی</span>
                <div class="text-lg md:text-xl font-black text-blue-600 dark:text-blue-400" dir="ltr">
                    @propertyData.PriceFormatted <span class="text-xs font-normal text-lajevard/60 dark:text-white/60" dir="rtl">تومان</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 border-t border-gray-100 dark:border-white/5">
            <div class="bg-gray-50 dark:bg-white/5 p-3 rounded-2xl flex items-center gap-3">
                <span class="text-2xl">📐</span>
                <div>
                    <span class="text-[10px] text-lajevard/50 dark:text-white/50 block">متراژ</span>
                    <span class="text-xs font-bold text-lajevard dark:text-white">@propertyData.Area متر مربع</span>
                </div>
            </div>

            <div class="bg-gray-50 dark:bg-white/5 p-3 rounded-2xl flex items-center gap-3">
                <span class="text-2xl">🛏️</span>
                <div>
                    <span class="text-[10px] text-lajevard/50 dark:text-white/50 block">اتاق خواب</span>
                    <span class="text-xs font-bold text-lajevard dark:text-white">@propertyData.Rooms خوابه</span>
                </div>
            </div>

            <div class="bg-gray-50 dark:bg-white/5 p-3 rounded-2xl flex items-center gap-3">
                <span class="text-2xl">🚗</span>
                <div>
                    <span class="text-[10px] text-lajevard/50 dark:text-white/50 block">پارکینگ</span>
                    <span class="text-xs font-bold text-lajevard dark:text-white">@(propertyData.ParkingCount > 0 ? $"{propertyData.ParkingCount} سندی" : "ندارد")</span>
                </div>
            </div>

            <div class="bg-gray-50 dark:bg-white/5 p-3 rounded-2xl flex items-center gap-3">
                <span class="text-2xl">🏗️</span>
                <div>
                    <span class="text-[10px] text-lajevard/50 dark:text-white/50 block">سن بنا</span>
                    <span class="text-xs font-bold text-lajevard dark:text-white">@propertyData.Age سال ساخت</span>
                </div>
            </div>
        </div>
    </div>

    <!-- امکانات و تگ‌ها -->
    <div class="bg-white dark:bg-sormee-light p-5 md:p-6 rounded-[2rem] border border-blue-600/10 dark:border-white/5 space-y-3">
        <h3 class="text-sm font-bold text-lajevard dark:text-white flex items-center gap-2">
            <span>✨</span> امکانات و تجهیزات
        </h3>
        <div class="flex flex-wrap gap-2 pt-1">
            @foreach (var feature in propertyData.Features)
            {
                <span class="px-3 py-1.5 bg-gray-50 dark:bg-white/5 text-lajevard/80 dark:text-white/80 border border-gray-200 dark:border-white/10 rounded-xl text-xs font-bold flex items-center gap-1.5">
                    <span class="text-emerald-500">✓</span>
                    @feature
                </span>
            }
        </div>
    </div>

    <!-- توضیحات متنی -->
    <div class="bg-white dark:bg-sormee-light p-5 md:p-6 rounded-[2rem] border border-blue-600/10 dark:border-white/5 space-y-3">
        <h3 class="text-sm font-bold text-lajevard dark:text-white flex items-center gap-2">
            <span>📝</span> متن آگهی / توضیحات
        </h3>
        <div class="text-xs md:text-sm text-lajevard/80 dark:text-white/80 leading-relaxed pt-1 prose dark:prose-invert max-w-none">
            @((MarkupString)propertyData.HtmlDescription)
        </div>
    </div>

    <!-- موقعیت روی نقشه -->
    <div class="bg-white dark:bg-sormee-light p-5 md:p-6 rounded-[2rem] border border-blue-600/10 dark:border-white/5 space-y-3">
        <h3 class="text-sm font-bold text-lajevard dark:text-white flex items-center gap-2">
            <span>📍</span> نقشه دقیق لوکیشن
        </h3>
        <div class="h-56 rounded-2xl overflow-hidden border border-gray-100 dark:border-white/5">
            <MapLocationPicker Latitude="propertyData.Latitude"
                               Longitude="propertyData.Longitude" />
        </div>
    </div>

    <!-- دکمه‌های عملیاتی داخل صفحه (بدون تداخل با BottomNav) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
        <button type="button" @onclick="GenerateCustomerShareCard" class="w-full py-3.5 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl text-xs font-bold shadow-lg shadow-blue-600/20 flex items-center justify-center gap-2 transition-all active:scale-95">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
            ارسال فایل برای مشتری (بدون مشخصات مالک)
        </button>

        <a href="tel:@propertyData.OwnerPhone" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl text-xs font-bold shadow-lg shadow-emerald-600/20 flex items-center justify-center gap-2 transition-all active:scale-95">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            تماس فوری با مالک
        </a>
    </div>

</div>

@code {
    [Parameter] public string Id { get; set; } = "1";

    private int activeImageIndex = 0;

    public class PrivatePropertyModel
    {
        public string Id { get; set; }
        public string Code { get; set; }
        public string Title { get; set; }
        public string Location { get; set; }
        public string DealType { get; set; }
        public long RawPrice { get; set; }
        public string PriceFormatted => RawPrice.ToString("N0");
        public int Area { get; set; }
        public int Rooms { get; set; }
        public int ParkingCount { get; set; }
        public int Age { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public List<string> Features { get; set; } = new();
        public List<string> Images { get; set; } = new();
        public string HtmlDescription { get; set; }

        // فیلدهای محرمانه مختص CRM مشاور
        public string OwnerName { get; set; }
        public string OwnerPhone { get; set; }
        public string BuildingPlate { get; set; }
        public int Floor { get; set; }
        public int UnitNumber { get; set; }
        public string Commission { get; set; }
        public string PrivateNotes { get; set; }
    }

    private PrivatePropertyModel propertyData = new()
    {
        Id = "1",
        Code = "1045",
        Title = "آپارتمان نوساز کلید نخورده تک‌واحدی",
        Location = "تهران، سعادت‌آباد، بلوار دریا، خ صرافها",
        DealType = "فروش",
        RawPrice = 14500000000,
        Area = 125,
        Rooms = 2,
        ParkingCount = 1,
        Age = 0,
        Latitude = 35.7796,
        Longitude = 51.3688,
        OwnerName = "حاج آقای رضایی (سازنده برند منطقه)",
        OwnerPhone = "09121234567",
        BuildingPlate = "24",
        Floor = 4,
        UnitNumber = 7,
        Commission = "۱ درصد کامل از طرفین + پاداش تسریع",
        PrivateNotes = "مالک تا ۱۴ میلیارد هم امضا می‌دهد ولی در جلسه رو نکنید. کلید نزد سرایدار (آقا رحمان) است.",
        Features = new() { "پارکینگ سندی", "آسانسور تمام اتوماتیک", "انباری ۶ متری", "بالکن رو به آفتاب", "کابینت های‌گلاس" },
        Images = new()
        {
            "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80",
            "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=80"
        },
        HtmlDescription = "<p>سالن پرده‌خور، دسترسی سریع، متریال درجه یک بدون پرتی.</p>"
    };

    private void NextImage()
    {
        if (activeImageIndex < propertyData.Images.Count - 1)
            activeImageIndex++;
        else
            activeImageIndex = 0;
    }

    private void PrevImage()
    {
        if (activeImageIndex > 0)
            activeImageIndex--;
        else
            activeImageIndex = propertyData.Images.Count - 1;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/folders");
    }

    private void EditProperty()
    {
        Navigation.NavigateTo($"/property/edit/{Id}");
    }

    private async Task GenerateCustomerShareCard()
    {
        // در این سناریو، فقط لینک عمومی یا متن بدون اطلاعات مالک کپی می‌شود
        var shareText = $"فایل {propertyData.DealType} کد {propertyData.Code}\n{propertyData.Title}\nمتراژ: {propertyData.Area} متر - {propertyData.Rooms} خواب\nقیمت: {propertyData.PriceFormatted} تومان\nجهت هماهنگی بازدید پیام دهید.";
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", shareText);
    }
}
