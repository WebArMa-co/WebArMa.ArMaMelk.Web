@inject IJSRuntime JSRuntime

<div class="relative w-full rounded-[1.5rem] overflow-hidden bg-red-50 dark:bg-sormee border border-blue-600/10 dark:border-white/5 group">

    <div class="absolute top-0 bottom-0 left-0 flex w-[160px] z-0">
        <button @onclick="EditClicked" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white flex flex-col items-center justify-center transition-colors border-r border-white/10 active:scale-95">
            <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            <span class="text-xs font-bold">ویرایش</span>
        </button>

        <button @onclick="DeleteClicked" class="flex-1 bg-red-500 hover:bg-red-600 text-white flex flex-col items-center justify-center transition-colors active:scale-95">
            <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            <span class="text-xs font-bold">حذف</span>
        </button>
    </div>

    <!-- اضافه شدن @ref="scrollContainer" و نشانگر ماوس (cursor-pointer) -->
    <div @ref="scrollContainer" class="relative z-10 flex w-full overflow-x-auto snap-x snap-mandatory [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none] cursor-pointer">

        <div class="w-full shrink-0 snap-start bg-white dark:bg-sormee-light shadow-sm rounded-[1.5rem] transition-transform">
            @ChildContent
        </div>

        <div class="w-[160px] shrink-0 snap-end pointer-events-none"></div>

    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private ElementReference scrollContainer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // اتصال رویدادهای ماوس به این کانتینر
            await JSRuntime.InvokeVoidAsync("swipeInterop.enableMouseDrag", scrollContainer);
        }
    }

    private async Task EditClicked()
    {
        await OnEdit.InvokeAsync();
    }

    private async Task DeleteClicked()
    {
        await OnDelete.InvokeAsync();
    }
}
