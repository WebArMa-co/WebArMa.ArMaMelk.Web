@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.IdentityModel.JsonWebTokens


@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="flex h-[100dvh] w-full overflow-hidden bg-persian-pattern text-lajevard dark:text-gray-100 transition-colors duration-300">

    <!-- سایدبار دسکتاپ -->
    <aside class="hidden lg:flex w-76 flex-col bg-gradient-to-b from-blue-600 to-indigo-900 dark:from-slate-800 dark:to-slate-950 border-none z-20 m-4 rounded-[2rem] shadow-[0_15px_40px_rgba(37,99,235,0.3)] dark:shadow-none transition-colors duration-300 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-300/15 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-40 h-40 bg-black/20 rounded-full blur-2xl translate-y-1/3 -translate-x-1/3 pointer-events-none"></div>
        <AppSidebar />
    </aside>

    <main class="flex-1 flex flex-col h-full relative">

        <!-- هدر با overflow-hidden برداشته شد تا منوی پروفایل بتونه بیرون بزنه -->
        <header class="h-16 lg:h-20 bg-white/85 dark:bg-sormee/80 backdrop-blur-xl border-none flex items-center justify-between px-4 lg:px-8 z-50 sticky top-0 m-3 lg:m-4 lg:ml-4 lg:mr-0 rounded-2xl lg:rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-none transition-colors duration-300 relative">

            <!-- ============================================== -->
            <!-- نوار جستجوی اختصاصی موبایل (پوشاننده هدر) -->
            <!-- ============================================== -->
            @if (isMobileSearchOpen)
            {
                <!-- این لایه روی هدر می‌افتد -->
                <div class="absolute inset-0 z-[60] bg-white/95 dark:bg-sormee-light/95 backdrop-blur-2xl flex items-center px-4 animate-fade-in lg:hidden gap-3 border border-blue-600/10 dark:border-white/5 rounded-2xl">

                    <button type="button" @onclick="() => isMobileSearchOpen = false" class="p-2 -ml-2 text-lajevard/60 dark:text-white/60 hover:text-blue-600 transition-colors bg-kahgel/50 dark:bg-sormee/50 rounded-xl">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>

                    <input type="text" placeholder="کد ملک، منطقه یا ..." class="flex-1 bg-transparent border-none outline-none text-sm text-lajevard dark:text-white placeholder-lajevard/40 dark:placeholder-white/40" autofocus />

                    <svg class="w-5 h-5 text-blue-600/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
            }

            <div class="lg:hidden font-bold text-lg text-lajevard dark:text-white">املاکِ من</div>

            <!-- جستجوی دسکتاپ -->
            <div class="hidden sm:flex items-center bg-kahgel/50 dark:bg-sormee-light/50 border border-blue-600/10 dark:border-white/10 rounded-2xl px-4 py-2.5 w-96 transition-all duration-300 focus-within:ring-2 focus-within:ring-blue-500/30 focus-within:bg-white dark:focus-within:bg-sormee">
                <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                <input type="text" placeholder="جستجو در فایل‌ها..." class="bg-transparent border-none outline-none text-sm w-full text-lajevard dark:text-white placeholder-lajevard/40 dark:placeholder-white/40" />
            </div>

            <!-- دکمه‌ها و پروفایل -->
            <div class="flex items-center gap-1.5 lg:gap-3">

                <!-- دکمه جستجو موبایل -->
                <button type="button" @onclick="() => isMobileSearchOpen = true" class="sm:hidden p-2 text-lajevard/70 dark:text-white/70 hover:bg-blue-600/10 dark:hover:bg-white/10 rounded-xl transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </button>

                <!-- دکمه تم -->
                <button onclick="toggleTheme()" class="p-2 text-lajevard/70 dark:text-yellow-400 hover:bg-blue-600/10 dark:hover:bg-white/10 rounded-xl transition-all duration-300 shrink-0">
                    <svg class="hidden dark:block w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    <svg class="block dark:hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                </button>

                <button class="bg-blue-600 text-white rounded-[14px] lg:rounded-[1.25rem] p-2.5 lg:px-6 lg:py-2.5 flex items-center gap-2 hover:bg-blue-700 shadow-lg shadow-blue-600/30 dark:shadow-none transition-all hover:-translate-y-0.5 active:scale-95 ml-1 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    <span class="hidden lg:inline text-sm font-bold">ثبت فایل</span>
                </button>

                <!-- ============================================== -->
                <!-- منوی کاربری (پروفایل) -->
                <!-- ============================================== -->
                <div class="relative">
                    <!-- دکمه آواتار -->
                    <button type="button" @onclick="ToggleProfileMenu" class="w-10 h-10 lg:w-11 lg:h-11 rounded-[14px] bg-blue-50 dark:bg-white/5 border border-blue-600/20 dark:border-white/10 flex items-center justify-center text-blue-600 dark:text-blue-400 font-black shadow-sm hover:ring-2 hover:ring-blue-500/50 transition-all overflow-hidden shrink-0">
                        <!-- اگر عکس داشت، img را فعال کنید، وگرنه حرف اول اسم نشان داده می‌شود -->
                        @* <img src="/images/avatar.jpg" class="w-full h-full object-cover" /> *@
                        <span class="text-sm lg:text-base">@userInitials</span>
                    </button>

                    <!-- کشوی پروفایل -->
                    @if (isProfileMenuOpen)
                    {
                        <!-- بک‌دراپ برای کلیک بیرون کادر -->
                        <div class="fixed inset-0 z-40" @onclick="CloseProfileMenu"></div>

                        <div class="absolute left-0 top-full mt-2 w-56 bg-white dark:bg-sormee-light rounded-[1.25rem] shadow-xl border border-gray-100 dark:border-white/5 z-50 overflow-hidden animate-fade-in-up">

                            <!-- مشخصات کاربر -->
                            <div class="px-4 py-3 border-b border-gray-100 dark:border-white/5 bg-gray-50/50 dark:bg-white/5">
                                <p class="text-sm font-bold text-lajevard dark:text-white">@userName</p>
                                <p class="text-[10px] text-lajevard/60 dark:text-white/60 mt-0.5">@userSubtitle</p>
                            </div>

                            <div class="p-2 space-y-1">
                                <!-- دکمه پروفایل -->
                                <button type="button" @onclick='() => NavigateTo("/profile")' class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-bold text-lajevard/80 dark:text-white/80 hover:bg-blue-50 dark:hover:bg-white/10 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                    ویرایش پروفایل
                                </button>

                                <!-- دکمه خروج -->
                                <button type="button" @onclick="Logout" class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-bold text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors">
                                    <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                                    خروج از حساب
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </header>

        <article class="flex-1 overflow-y-auto px-4 pb-32 lg:pb-8 lg:pr-0">
            @Body
        </article>

        <AppToast />
    </main>

    <div class="lg:hidden fixed bottom-4 left-4 right-4 bg-gradient-to-l from-blue-600 to-indigo-900 dark:from-slate-800 dark:to-slate-950 border-t border-white/10 z-50 rounded-[1.75rem] shadow-[0_20px_40px_rgba(37,99,235,0.3)] dark:shadow-black/40 transition-colors duration-300 overflow-hidden pb-safe">
        <AppBottomNav />
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool isMobileSearchOpen = false;
    private bool isProfileMenuOpen = false;

    private string userName = "کاربر";
    private string userInitials = "?";
    private string userSubtitle = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
            return;

        var authState = await AuthState;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var givenName = user.FindFirst(JwtRegisteredClaimNames.GivenName)?.Value;
            var familyName = user.FindFirst(JwtRegisteredClaimNames.FamilyName)?.Value;
            var phone = user.FindFirst(JwtRegisteredClaimNames.PhoneNumber)?.Value;

            var fullName = string.Join(" ", new[] { givenName, familyName }
                .Where(n => !string.IsNullOrWhiteSpace(n) && n != phone));

            userName = !string.IsNullOrWhiteSpace(fullName) ? fullName : (phone ?? "کاربر");
            userSubtitle = phone ?? "";
            userInitials = GetInitials(userName);
        }
    }

    private static string GetInitials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return "?";
        if (parts.Length == 1)
            return parts[0].Length >= 2 ? parts[0][..2] : parts[0][..1];
        return $"{parts[0][..1]}.{parts[^1][..1]}";
    }

    private void ToggleProfileMenu() => isProfileMenuOpen = !isProfileMenuOpen;
    private void CloseProfileMenu() => isProfileMenuOpen = false;

    private void NavigateTo(string url)
    {
        CloseProfileMenu();
        Navigation.NavigateTo(url);
    }

    private void Logout()
    {
        CloseProfileMenu();
        Navigation.NavigateTo("/Auth/Logout", forceLoad: true);
    }
}


