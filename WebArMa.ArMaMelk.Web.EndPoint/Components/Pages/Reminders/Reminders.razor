@page "/reminders"
@inject NavigationManager Navigation

<!-- فاصله استاندارد با BottomNav با کلاس pb-36 -->
<div class="w-full max-w-4xl mx-auto p-4 md:p-6 pb-36 space-y-6">

    <!-- هدر صفحه -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black text-lajevard dark:text-white">یادآوری‌ها و قرارها</h1>
            <p class="text-xs md:text-sm text-lajevard/60 dark:text-white/60 mt-0.5">مدیریت بازدیدها، جلسات قرارداد و پیگیری‌های کاری</p>
        </div>

        <button type="button"
                @onclick="OpenAddModal"
                class="px-4 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl text-xs font-bold shadow-lg shadow-blue-600/30 flex items-center gap-2 transition-all active:scale-95">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            قرار جدید
        </button>
    </div>

    <!-- نوار روزشمار افقی لمسی (Horizontal Date Strip) -->
    <div class="bg-white dark:bg-sormee-light p-3 rounded-[2rem] border border-blue-600/10 dark:border-white/5 shadow-sm">
        <div class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
            @foreach (var day in WeekDays)
            {
                bool isSelected = selectedDate.Date == day.Date.Date;
                bool isToday = DateTime.Now.Date == day.Date.Date;
                <button type="button"
                        @onclick="() => SelectDate(day.Date)"
                        class="flex-1 min-w-[62px] py-3 px-2 rounded-2xl flex flex-col items-center gap-1 transition-all @(isSelected ? "bg-blue-600 text-white shadow-md shadow-blue-600/30 scale-105" : "bg-gray-50 dark:bg-white/5 text-lajevard dark:text-white hover:bg-gray-100")">
                    <span class="text-[10px] font-medium @(isSelected ? "text-blue-100" : "text-lajevard/50 dark:text-white/50")">
                        @(isToday ? "امروز" : day.DayName)
                    </span>
                    <span class="text-base font-black">@day.DayNumber</span>
                    @if (day.HasTask && !isSelected)
                    {
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                    }
                    else
                    {
                        <span class="w-1.5 h-1.5"></span>
                    }
                </button>
            }
        </div>
    </div>

    <!-- فیلتر سریع بر اساس نوع فعالیت (Filter Chips) -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
        @foreach (var filter in FilterOptions)
        {
            bool isActive = selectedFilter == filter.Key;
            <button type="button"
                    @onclick="() => selectedFilter = filter.Key"
                    class="px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all border @(isActive ? "bg-blue-600 text-white border-blue-600 shadow-sm" : "bg-white dark:bg-sormee-light text-lajevard/70 dark:text-white/70 border-gray-200 dark:border-white/10")">
                @filter.Title
            </button>
        }
    </div>

    <!-- آمار خلاصه کارهای امروز -->
    <div class="grid grid-cols-3 gap-3">
        <div class="bg-white dark:bg-sormee-light p-3.5 rounded-2xl border border-gray-100 dark:border-white/5 text-center">
            <span class="text-[10px] text-lajevard/50 dark:text-white/50 block">کل قرارها</span>
            <span class="text-base font-black text-lajevard dark:text-white">@CurrentDayReminders.Count</span>
        </div>
        <div class="bg-white dark:bg-sormee-light p-3.5 rounded-2xl border border-gray-100 dark:border-white/5 text-center">
            <span class="text-[10px] text-emerald-600 dark:text-emerald-400 block">انجام شده</span>
            <span class="text-base font-black text-emerald-600">@CurrentDayReminders.Count(r => r.IsDone)</span>
        </div>
        <div class="bg-white dark:bg-sormee-light p-3.5 rounded-2xl border border-gray-100 dark:border-white/5 text-center">
            <span class="text-[10px] text-amber-600 dark:text-amber-400 block">در انتظار</span>
            <span class="text-base font-black text-amber-600">@CurrentDayReminders.Count(r => !r.IsDone)</span>
        </div>
    </div>

    <!-- لیست کارت‌های یادآوری -->
    <div class="space-y-3">
        @if (!FilteredReminders.Any())
        {
            <div class="bg-white dark:bg-sormee-light p-8 rounded-[2rem] border border-dashed border-gray-200 dark:border-white/10 text-center space-y-2">
                <span class="text-3xl">☕</span>
                <h4 class="text-xs font-bold text-lajevard dark:text-white">هیچ یادآوری برای این تاریخ ثبت نشده است</h4>
                <p class="text-[11px] text-lajevard/50 dark:text-white/50">می‌توانید با زدن دکمه «قرار جدید» یک جلسه یا بازدید جدید ثبت کنید.</p>
            </div>
        }
        else
        {
            @foreach (var item in FilteredReminders)
            {
                <div class="bg-white dark:bg-sormee-light p-4 rounded-2xl border border-gray-100 dark:border-white/5 shadow-sm transition-all @(item.IsDone ? "opacity-60 bg-gray-50/50" : "")">
                    <div class="flex items-start justify-between gap-3">

                        <!-- چک‌باکس انجام کار -->
                        <button type="button"
                                @onclick="() => ToggleDone(item)"
                                class="mt-0.5 w-6 h-6 rounded-xl border-2 flex items-center justify-center transition-all @(item.IsDone ? "bg-emerald-500 border-emerald-500 text-white" : "border-gray-300 dark:border-white/20 hover:border-blue-500")">
                            @if (item.IsDone)
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            }
                        </button>

                        <!-- اطلاعات اصلی یادآوری -->
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-black @GetCategoryBadgeClass(item.Category)">
                                    @GetCategoryTitle(item.Category)
                                </span>
                                <span class="text-xs font-black text-blue-600 dark:text-blue-400" dir="ltr">
                                    ⏰ @item.Time
                                </span>
                                @if (item.IsUrgent)
                                {
                                    <span class="text-[9px] bg-red-100 text-red-600 dark:bg-red-500/20 px-1.5 py-0.5 rounded font-bold">فوری</span>
                                }
                            </div>

                            <h4 class="font-bold text-sm text-lajevard dark:text-white mt-1.5 @(item.IsDone ? "line-through text-gray-400" : "")">
                                @item.Title
                            </h4>

                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="text-xs text-lajevard/60 dark:text-white/60 mt-1 line-clamp-2">
                                    @item.Description
                                </p>
                            }

                            <!-- اطلاعات طرف حساب یا ملک متصل -->
                            <div class="flex flex-wrap items-center gap-3 mt-3 pt-2 border-t border-gray-100 dark:border-white/5 text-[11px] text-lajevard/60 dark:text-white/60">
                                @if (!string.IsNullOrEmpty(item.ContactPerson))
                                {
                                    <span class="flex items-center gap-1 font-bold text-lajevard dark:text-white">
                                        👤 @item.ContactPerson (@item.ContactRole)
                                    </span>
                                }

                                @if (!string.IsNullOrEmpty(item.PropertyId))
                                {
                                    <button type="button" @onclick="() => NavigateToProperty(item.PropertyId)" class="text-blue-600 hover:underline flex items-center gap-1 font-bold">
                                        🏡 فایل: @item.PropertyTitle
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- اکشن‌های سریع سمت چپ (تماس و حذف) -->
                        <div class="flex items-center gap-1">
                            @if (!string.IsNullOrEmpty(item.ContactPhone))
                            {
                                <a href="tel:@item.ContactPhone" class="p-2 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 hover:bg-emerald-100 transition-colors" title="تماس">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                                </a>
                            }
                            <button type="button" @onclick="() => DeleteReminder(item.Id)" class="p-2 rounded-xl text-gray-400 hover:text-red-500 hover:bg-gray-100 dark:hover:bg-white/5 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </div>

                    </div>
                </div>
            }
        }
    </div>

</div>

<!-- مدال ثبت یادآوری / قرار جدید -->
@if (isAddModalOpen)
{
    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[9999] flex items-center justify-center p-4">
        <div class="bg-white dark:bg-sormee-light w-full max-w-lg p-6 rounded-[2rem] shadow-xl space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-gray-100 dark:border-white/5 pb-3">
                <h3 class="font-bold text-lg text-lajevard dark:text-white">ثبت قرار یا یادآوری جدید</h3>
                <button type="button" @onclick="() => isAddModalOpen = false" class="text-gray-400 hover:text-red-500">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="space-y-3">
                <!-- عنوان -->
                <div>
                    <label class="text-xs font-bold text-lajevard/70 dark:text-white/70 block mb-1">عنوان کار / جلسه</label>
                    <input type="text" @bind="newReminder.Title" placeholder="مثلاً: بازدید حضوری با آقای صابری" class="w-full bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-xl p-3 text-xs text-lajevard dark:text-white focus:outline-none focus:border-blue-500" />
                </div>

                <!-- دسته‌بندی و ساعت -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-lajevard/70 dark:text-white/70 block mb-1">نوع فعالیت</label>
                        <select @bind="newReminder.Category" class="w-full bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-xl p-3 text-xs text-lajevard dark:text-white focus:outline-none focus:border-blue-500">
                            <option value="visit">بازدید ملک</option>
                            <option value="contract">نشست قرارداد</option>
                            <option value="call">تماس با مالک</option>
                            <option value="followup">پیگیری خریدار</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-lajevard/70 dark:text-white/70 block mb-1">ساعت قرار</label>
                        <input type="time" @bind="newReminder.Time" class="w-full bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-xl p-3 text-xs text-lajevard dark:text-white focus:outline-none focus:border-blue-500" />
                    </div>
                </div>

                <!-- طرف حساب و شماره تماس -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-lajevard/70 dark:text-white/70 block mb-1">نام شخص طرف حساب</label>
                        <input type="text" @bind="newReminder.ContactPerson" placeholder="آقای احمدی" class="w-full bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-xl p-3 text-xs text-lajevard dark:text-white focus:outline-none focus:border-blue-500" />
                    </div>
                    <div>
                        <label class="text-xs font-bold text-lajevard/70 dark:text-white/70 block mb-1">شماره تماس</label>
                        <input type="tel" @bind="newReminder.ContactPhone" placeholder="0912..." class="w-full bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-xl p-3 text-xs text-lajevard dark:text-white focus:outline-none focus:border-blue-500" dir="ltr" />
                    </div>
                </div>

                <!-- توضیحات تکمیلی -->
                <div>
                    <label class="text-xs font-bold text-lajevard/70 dark:text-white/70 block mb-1">توضیحات و نکات قبل از جلسه</label>
                    <textarea @bind="newReminder.Description" rows="2" placeholder="کلید دست سرایدار است، سر قیمت خیلی چانه نزنید..." class="w-full bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-xl p-3 text-xs text-lajevard dark:text-white focus:outline-none focus:border-blue-500"></textarea>
                </div>

                <!-- چک‌باکس فوریت -->
                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="urgentCheck" @bind="newReminder.IsUrgent" class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500" />
                    <label for="urgentCheck" class="text-xs font-bold text-red-500 cursor-pointer">این قرار اولویت بالا و فوری دارد</label>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-3 border-t border-gray-100 dark:border-white/5">
                <button type="button" @onclick="() => isAddModalOpen = false" class="px-4 py-2.5 text-xs font-bold text-gray-500">انصراف</button>
                <button type="button" @onclick="SaveReminder" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-md shadow-blue-600/20">ثبت قرار</button>
            </div>
        </div>
    </div>
}

@code {
    public class ReminderItem
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N");
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime Date { get; set; }

        public TimeOnly? Time { get; set; } = new TimeOnly(12, 0);
        public string TimeFormatted => Time.HasValue ? Time.Value.ToString("HH:mm") : "--:--";

        public string Category { get; set; } = "visit";
        public bool IsDone { get; set; }
        public bool IsUrgent { get; set; }
        public string ContactPerson { get; set; } = "";
        public string ContactRole { get; set; } = "";
        public string ContactPhone { get; set; } = "";
        public string PropertyId { get; set; } = "";
        public string PropertyTitle { get; set; } = "";
    }

    public class DayTab
    {
        public DateTime Date { get; set; }
        public string DayName { get; set; }
        public string DayNumber { get; set; }
        public bool HasTask { get; set; }
    }

    private DateTime selectedDate = DateTime.Now;
    private string selectedFilter = "all";
    private bool isAddModalOpen = false;

    private List<DayTab> WeekDays = new();

    private List<(string Key, string Title)> FilterOptions = new()
    {
        ("all", "همه فعالیت‌ها"),
        ("visit", "بازدید ملک"),
        ("contract", "نشست و قرارداد"),
        ("call", "تماس مالک"),
        ("followup", "پیگیری مشتری")
    };

    private static List<ReminderItem> RemindersList = new()
    {
        new ReminderItem { Title = "بازدید آپارتمان با متقاضی نقد", Category = "visit", Time = new TimeOnly(11, 30), Date = DateTime.Now, ContactPerson = "مهندس کاظمی", ContactRole = "خریدار", ContactPhone = "09121111111", PropertyId = "1", PropertyTitle = "آپارتمان ۱۲۵ متری سعادت‌آباد", IsUrgent = true },
        new ReminderItem { Title = "نشست قرارداد فروش واحد اداری", Category = "contract", Time = new TimeOnly(17, 0), Date = DateTime.Now, ContactPerson = "حاج آقا رضایی", ContactRole = "مالک", ContactPhone = "09122222222", PropertyId = "2", PropertyTitle = "واحد اداری میرداماد" },
        new ReminderItem { Title = "تماس با مالک پنت‌هاوس فرشته", Category = "call", Time = new TimeOnly(19, 15), Date = DateTime.Now, ContactPerson = "آقای تهرانی", ContactRole = "مالک", ContactPhone = "09123333333" }
    };

    private ReminderItem newReminder = new()
    {
        Date = DateTime.Now,
        Time = new TimeOnly(12, 0),
        Category = "visit"
    };

    protected override void OnInitialized()
    {
        BuildWeekDays();
    }

    private void BuildWeekDays()
    {
        WeekDays.Clear();
        var start = DateTime.Now.AddDays(-2);
        for (int i = 0; i < 7; i++)
        {
            var day = start.AddDays(i);
            WeekDays.Add(new DayTab
            {
                Date = day,
                DayName = GetPersianDayName(day.DayOfWeek),
                DayNumber = day.Day.ToString(),
                HasTask = RemindersList.Any(r => r.Date.Date == day.Date)
            });
        }
    }

    private string GetPersianDayName(DayOfWeek dayOfWeek) => dayOfWeek switch
    {
        DayOfWeek.Saturday => "شنبه",
        DayOfWeek.Sunday => "۱شنبه",
        DayOfWeek.Monday => "۲شنبه",
        DayOfWeek.Tuesday => "۳شنبه",
        DayOfWeek.Wednesday => "۴شنبه",
        DayOfWeek.Thursday => "۵شنبه",
        DayOfWeek.Friday => "جمعه",
        _ => ""
    };

    private List<ReminderItem> CurrentDayReminders => RemindersList
        .Where(r => r.Date.Date == selectedDate.Date)
        .ToList();

    private List<ReminderItem> FilteredReminders
    {
        get
        {
            var list = CurrentDayReminders.AsEnumerable();
            if (selectedFilter != "all")
                list = list.Where(r => r.Category == selectedFilter);

            return list.OrderBy(r => r.IsDone).ThenBy(r => r.Time).ToList();
        }
    }

    private void SelectDate(DateTime date)
    {
        selectedDate = date;
    }

    private void ToggleDone(ReminderItem item)
    {
        item.IsDone = !item.IsDone;
    }

    private void DeleteReminder(string id)
    {
        RemindersList.RemoveAll(r => r.Id == id);
        BuildWeekDays();
    }

    private void OpenAddModal()
    {
        newReminder = new ReminderItem
        {
            Date = selectedDate,
            Time = new TimeOnly(12, 0),
            Category = "visit"
        };
        isAddModalOpen = true;
    }

    private void SaveReminder()
    {
        if (!string.IsNullOrWhiteSpace(newReminder.Title))
        {
            newReminder.Date = selectedDate;
            RemindersList.Add(newReminder);
            BuildWeekDays();
        }
        isAddModalOpen = false;
    }

    private void NavigateToProperty(string propId)
    {
        Navigation.NavigateTo($"/property/{propId}");
    }

    private string GetCategoryTitle(string cat) => cat switch
    {
        "visit" => "بازدید ملک",
        "contract" => "نشست قرارداد",
        "call" => "تماس با مالک",
        "followup" => "پیگیری مشتری",
        _ => "عمومی"
    };

    private string GetCategoryBadgeClass(string cat) => cat switch
    {
        "visit" => "bg-blue-100 text-blue-700 dark:bg-blue-500/20 dark:text-blue-400",
        "contract" => "bg-purple-100 text-purple-700 dark:bg-purple-500/20 dark:text-purple-400",
        "call" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-400",
        "followup" => "bg-amber-100 text-amber-700 dark:bg-amber-500/20 dark:text-amber-400",
        _ => "bg-gray-100 text-gray-700"
    };
}
