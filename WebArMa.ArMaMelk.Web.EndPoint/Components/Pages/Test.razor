    private void HandleFabAction(FabSpeedDial.FabAction action)
    {
        switch (action)
        {
            case FabSpeedDial.FabAction.NewProperty:
                ToastService.ShowInfo("در حال باز کردن فرم ثبت ملک...");
                // NavigationManager.NavigateTo("/add-property");
                break;

            case FabSpeedDial.FabAction.NewReminder:
                ToastService.ShowSuccess("تقویم یادآوری‌ها باز شد.");
                break;

            case FabSpeedDial.FabAction.NewRequest:
                ToastService.ShowInfo("فرم ثبت تقاضای مشتری باز شد.");
                break;
        }
    }
